{
  "name": "opencode-telegram-gateway",
  "version": "2.0.0",
  "description": "Control OpenCode sessions from Telegram over outbound long polling. No ports, no tunnels.",
  "type": "module",
  "license": "MIT",
  "author": "Aniket Somkuwar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aniketsomkuwar/opencode-telegram-gateway.git"
  },
  "keywords": [
    "opencode",
    "telegram",
    "bot",
    "gateway",
    "remote-control",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "opencode-telegram-gateway": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js run",
    "dev": "node --watch src/index.ts run",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "config.example.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ]
}

